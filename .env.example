# Copie para .env e ajuste. O compose funciona sem .env (defaults de dev
# ja embutidos no docker-compose.yml); use este arquivo so para sobrescrever
# algo. Nunca commite o .env real (docs/07 §6).
# D-48: fora do perfil `local`, o backend recusa subir com APP_JWT_SECRET (ou,
# no perfil `demo`, APP_SEED_ADMIN_PASSWORD) iguais aos valores de exemplo
# abaixo — defina valores proprios em demo/prod.

SPRING_PROFILES_ACTIVE=local                          # local | demo | prod (demo carrega o seed ficticio)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/reservas   # troque para o Supabase em prod
SPRING_DATASOURCE_USERNAME=reservas                   # usuario do Postgres (local e do container postgres)
SPRING_DATASOURCE_PASSWORD=reservas                   # senha do Postgres (dev; troque em prod)

APP_TIMEZONE=America/Sao_Paulo                        # fuso das regras de negocio (RNs de horario)
APP_PUBLIC_URL=http://localhost                       # origem permitida por CORS e usada em links
APP_JWT_SECRET=dev-only-secret-nao-usar-em-producao-0123456789   # >= 32 bytes; troque em demo/prod
APP_COOKIE_SECURE=false                               # true em demo/prod (sempre HTTPS, RNF-02)

APP_STORAGE_ENDPOINT=http://s3:7070                   # onde o backend fala com o S3 (rede interna)
APP_STORAGE_PUBLIC_URL=/storage                       # prefixo que o navegador usa (proxy do nginx, D-41)
APP_STORAGE_BUCKET=reservas                           # bucket privado das fotos
APP_STORAGE_ACCESS_KEY=minioadmin                     # credencial de dev do Versity S3 Gateway local
APP_STORAGE_SECRET_KEY=minioadmin                     # credencial de dev do Versity S3 Gateway local
APP_STORAGE_REGION=us-east-1                          # exigida pelo cliente S3, sem efeito local
APP_STORAGE_CREATE_BUCKET=true                        # cria o bucket na subida se faltar (false em prod/Supabase)

APP_SEED_ADMIN_EMAIL=admin@exemplo.test               # conta ADMIN inicial (dados ficticios)
APP_SEED_ADMIN_PASSWORD=troque-esta-senha             # senha da conta ADMIN inicial
APP_CONDOMINIUM_NAME=Residencial Exemplo              # nome do condominio de demonstracao
# APP_DEFAULT_PAYMENT_WHATSAPP=                       # WhatsApp padrao da administracao (opcional, D-42)

# APP_LOCAL_SEED_ENABLED=true                         # FD-1: seed minimo do perfil local (sindico/unidades/areas ficticios)
# APP_LOCAL_SEED_PASSWORD=LocalDev123!                # senha das contas ficticias do seed local (sindico e unidades)

# APP_DEMO_NOW=2026-11-10T10:00                       # relogio simulado do perfil demo; vazio = relogio real
# APP_DEMO_PASSWORD=                                  # senha das contas ficticias de demonstracao (exceto a-102)
# APP_DEMO_TEMP_PASSWORD=                             # senha temporaria fixa da unidade a-102 (RN-03)
# APP_DEMO_ADMIN_WHATSAPP=                            # numero real de um integrante (unica excecao a dado ficticio)

TZ=UTC                                                # fuso do SO/JVM; as regras usam APP_TIMEZONE
